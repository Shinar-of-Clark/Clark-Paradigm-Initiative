{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "一键编译论文(XeLaTeX)",
            "type": "shell",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "1.tex"
            ],
            "options": {
                "cwd": "${workspaceFolder}/papers/paper-1-causal-mapping"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": "$gcc"
        }
    ]
}
